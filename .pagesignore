# Block list for the GitHub Pages deploy (.github/workflows/deploy.yml).
# Everything in the repo is published EXCEPT paths matching a line below
# (rsync --exclude patterns). Add internal files and folders here.
.git*
.pagesignore
_site/
*.md
*.bak
*.py
*.pyc
*.mjs
*.sh
__pycache__/
node_modules/
docs/
scripts/
tests/
content/
src/
qa_*
